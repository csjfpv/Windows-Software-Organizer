{
  "name": "windows-software-organizer",
  "version": "0.1.6",
  "description": "A local Windows software and project launchpad.",
  "main": "dist-electron/main.js",
  "author": "csjfpv",
  "license": "MIT",
  "private": false,
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -p tsconfig.electron.json && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "package:win": "pnpm build && electron-builder --win nsis portable --publish never",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "io.github.csjfpv.windowssoftwareorganizer",
    "productName": "软件启动台",
    "icon": "build/icon.ico",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      { "from": "LICENSE", "to": "notices/LICENSE.txt" },
      { "from": "THIRD_PARTY_NOTICES.md", "to": "notices/THIRD-PARTY-NOTICES.txt" },
      { "from": "ASSET_SOURCES.md", "to": "notices/ASSET-SOURCES.txt" },
      { "from": "TRADEMARKS.md", "to": "notices/TRADEMARKS.txt" }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "packageManager": "pnpm@11.24.0"
}
